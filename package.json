{
  "name": "mindspace-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint",
    "test": "node --test tests/*.test.mjs",
    "dev:db-demo": "VITE_DASHBOARD_API_URL=http://127.0.0.1:3001/v1/dashboard/demo VITE_DASHBOARD_DEMO=1 vite --host 127.0.0.1 --port 5175 --strictPort"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
